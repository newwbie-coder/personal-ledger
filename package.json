{
  "name": "collaborative-ledger",
  "private": true,
  "version": "2.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @ledger/api",
    "dev:web": "npm run dev -w @ledger/web",
    "build": "npm run build -w @ledger/db && npm run build -w @ledger/shared && npm run build -w @ledger/api && npm run build -w @ledger/web",
    "start": "npm run start -w @ledger/api",
    "box": "npm run box -w @ledger/api --",
    "license:keygen": "node scripts/license/keygen.mjs",
    "license:issue": "node scripts/license/issue.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
