# ---- Office box (docker compose) ----
# Long random password for the box's own Postgres. Never leaves this machine.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Addresses phones use to reach the box: the WireGuard address, plus the LAN IP if staff use office Wi-Fi.
BOX_HOSTS=10.8.0.1,192.168.1.50
# Nightly encrypted backups. Leave BACKUP_PASSPHRASE empty to turn them off (not recommended).
BACKUP_PASSPHRASE=
BACKUP_KEEP=30
NIGHTLY_HOUR=2
# Where backups land on the host. Point this at a USB drive or NAS share.
BACKUP_HOST_DIR=./backups
# Set to the box's LAN or WireGuard IP to stop the app listening on other interfaces.
BIND_ADDRESS=0.0.0.0

# ---- Local development only ----
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/ledger
# CORS_ORIGIN=http://localhost:5173
# VITE_API_URL=http://localhost:4000
# LEDGER_DATA_DIR=./data
