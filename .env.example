# Your Control Database (platform-owned — workspace metadata ONLY)
# Never store ledger/party data here. Use Session pooler URI for Supabase.
CONTROL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ledger_control

# API (Railway sets PORT automatically)
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-workspace-db-encryption-key
LICENSE_SERVER_URL=http://localhost:4100
LICENSE_SERVER_SECRET=dev-license-secret
# Comma-separated browser origins allowed to call the API (Vercel URL in production)
CORS_ORIGIN=*

# License server
LICENSE_PORT=4100
LICENSE_ADMIN_SECRET=dev-admin-secret

# Web (Vite) — must be public API URL when building for Vercel
VITE_API_URL=http://localhost:4000
